APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=spendsense
# Local accounts are isolated development fixtures. Disable for deployment.
ALLOW_DEV_LOGIN=true
# Google OAuth web client ID. No Firebase account is needed.
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
MODEL_PATH=artifacts/best.pt
# Set paddleocr after installing the isolated ocr environment; run the worker.
EXTRACTION_PROVIDER=checkpoint
OCR_PYTHON=ocr/.venv/Scripts/python.exe
OCR_RUNNER=ocr/run.py
# Optional evaluated recognizer export; omit to use the original pretrained model.
# OCR_RECOGNITION_MODEL_DIR=artifacts/paddle-finetune/run-v2/inference
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
